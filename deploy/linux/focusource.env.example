HOST=127.0.0.1
PORT=4173
NODE_ENV=production
TRUST_PROXY=1
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Optional Resend email delivery. Verify your sending domain with Resend first.
# The sender must belong to that verified domain. Gmail can be the recipient.
RESEND_API_KEY=
INQUIRY_EMAIL_FROM=
INQUIRY_EMAIL_TO=
